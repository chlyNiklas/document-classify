KOBY_CLASSIFY_ENVIRONMENT=local
KOBY_CLASSIFY_LOG_LEVEL=INFO
KOBY_CLASSIFY_API_PREFIX=/v1
KOBY_CLASSIFY_MAX_UPLOAD_BYTES=10485760
KOBY_CLASSIFY_MAX_EXTRACTED_CHARACTERS=100000
# Maximum extracted characters sent in one classification request.
KOBY_CLASSIFY_CLASSIFICATION_CHUNK_CHARACTERS=50000
# Protect classification requests with OAuth 2.0 bearer access tokens.
KOBY_CLASSIFY_AUTH_ENABLED=false
# Required when authentication is enabled. Values come from the API's OIDC client/resource setup.
# KOBY_CLASSIFY_AUTH_ISSUER=https://identity.example/realms/example
# KOBY_CLASSIFY_AUTH_AUDIENCE=classify-api
# KOBY_CLASSIFY_AUTH_JWKS_URL=https://identity.example/realms/example/protocol/openid-connect/certs
KOBY_CLASSIFY_AUTH_ALGORITHMS=RS256
KOBY_CLASSIFY_AUTH_REQUIRED_SCOPE=document:classify
KOBY_CLASSIFY_AUTH_JWKS_CACHE_SECONDS=300
# Comma-separated list of browser origins allowed to call the API (CORS).
KOBY_CLASSIFY_CORS_ORIGINS=http://localhost:4200
KOBY_LLM_URL=
KOBY_TOKEN_URL=https://r.auth.koby.admin.ch/realms/fbcfa3d6-6fad-43fb-9d37-0c76a28495f6/protocol/openid-connect/token
KOBY_CLIENT_ID=
KOBY_CLIENT_SECRET=
# Total timeout for token and model requests.
KOBY_TIMEOUT_SECONDS=120
# Lower reasoning reduces latency for this bounded classification task.
KOBY_REASONING_EFFORT=low
# Optional override. The repository-root ISG rulebook is used by default.
# KOBY_ISG_RULEBOOK_PATH=/absolute/path/to/REGELWERK_ISG_KLASSIFIZIERUNG.md
# Optional override. The repository-root DSG rulebook is used by default.
# KOBY_DSG_RULEBOOK_PATH=/absolute/path/to/REGELWERK_DSG_KLASSIFIZIERUNG.md
# Optional. Include this when the gateway requires a model in the request body.
KOBY_MODEL=
# Optional path to a PEM bundle containing the internal certificate authority.
KOBY_CA_BUNDLE=
# Keep true in production. False is only for local testing against a known internal endpoint.
KOBY_VERIFY_TLS=true

