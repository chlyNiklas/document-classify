KOBY_CLASSIFY_ENVIRONMENT=local
KOBY_CLASSIFY_LOG_LEVEL=INFO
KOBY_CLASSIFY_API_PREFIX=/v1
KOBY_CLASSIFY_MAX_UPLOAD_BYTES=10485760
KOBY_CLASSIFY_MAX_EXTRACTED_CHARACTERS=100000
KOBY_LLM_URL=
KOBY_TOKEN_URL=https://r.auth.koby.admin.ch/realms/fbcfa3d6-6fad-43fb-9d37-0c76a28495f6/protocol/openid-connect/token
KOBY_CLIENT_ID=
KOBY_CLIENT_SECRET=
# Optional. Include this when the gateway requires a model in the request body.
KOBY_MODEL=
# Optional path to a PEM bundle containing the internal certificate authority.
KOBY_CA_BUNDLE=
# Keep true in production. False is only for local testing against a known internal endpoint.
KOBY_VERIFY_TLS=true

